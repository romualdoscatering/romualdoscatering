{
  "name": "Romualdo's Staff",
  "short_name": "Romualdo's",
  "description": "Events, purchasing, stock, kitchen stocks, POS and billing for the Romualdo's team.",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1A2C54",
  "theme_color": "#14213f",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "standalone"
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "categories": [
    "business",
    "food",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Events",
      "url": "/app/#/c/events",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Purchase requests",
      "url": "/app/#/c/requests",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Kitchen stocks",
      "url": "/app/#/r/kitchen",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Recipes & costing",
      "url": "/app/#/c/recipes",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}